# Copie para .env e preencha
LLM_BACKEND=opencode_cli
# LLM Gateway — Muse Spark via endpoint OpenAI-Compatible (OpenCode / outro gateway)
LLM_BASE_URL=http://127.0.0.1:4096/v1
LLM_API_KEY=sk-local-placeholder
LLM_MODEL=opencode/muse-spark-1.3-contributor-free

# Interface
TELEGRAM_BOT_TOKEN=
# Seu ID numérico do Telegram (fale com @userinfobot). Vazio = ninguém autorizado.
TELEGRAM_WHITELIST_IDS=
DISCORD_BOT_TOKEN=
DISCORD_WHITELIST_IDS=

# Browser
BROWSER_USER_DATA_DIR=./.browser-profile
BROWSER_HEADLESS=false
BROWSER_CDP_URL=http://127.0.0.1:9222
# Allowlist opcional de domínios (csv). Vazia = qualquer site público (mas nunca rede interna).
# Ex: ALLOWED_DOMAINS=example.com,mercadolivre.com.br
ALLOWED_DOMAINS=
# Para plugar no Chrome real aberto com:
# chrome.exe --remote-debugging-port=9222 --user-data-dir="C:\chrome-agent"

# Orquestrador
MAX_STEPS=12
LOOP_REPEAT_LIMIT=3
LOG_DIR=./logs

# Tarefas
TASK_TIMEOUT_SEC=1500
QUEUE_MAX=5
RATE_LIMIT_SEC=10
DUP_WINDOW_SEC=60
HISTORY_MAX=20

# Operações locais (desligadas por padrão; navegador continua igual)
LOCAL_TOOLS_ENABLED=false
GRANTS_PATH=./data/grants.json
BACKUP_DIR=./logs/backups
FS_MAX_FILE_MB=2
FS_MAX_RESULT_CHARS=200000
CMD_TIMEOUT_SEC=300
CMD_MAX_OUTPUT_KB=200
TASK_MODE_DEFAULT=browser

# Modo autônomo (sem nenhuma autorização; operador assume risco total)
AUTONOMOUS_MODE=false
ALLOW_CREDENTIALS=false
DISABLE_URL_GUARD=false
AUTO_GRANT_ROOT=
